{
  "name": "l2-send-guard",
  "version": "0.5.0",
  "description": "Policy guard for agent and bot wallets: checks every signed EVM transaction (allowlists, approve/Permit2 bounds through Multicall3, Safe and 7702 batches, rolling caps, idempotency) and simulates it before your RPC sees it. Never holds keys.",
  "type": "module",
  "main": "./dist/api.js",
  "bin": {
    "l2-send-guard": "./dist/index.js"
  },
  "files": [
    "dist",
    "policy.example.json",
    "policy.agent.example.json",
    ".env.example",
    "docs/POLICY.md",
    "docs/TROUBLESHOOTING.md",
    "src/sdk/README.md",
    "SECURITY.md",
    "SUPPORT.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yellowgram/l2-safety-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/yellowgram/l2-safety-proxy/issues"
  },
  "homepage": "https://www.yellowgram.dev/oss",
  "author": {
    "name": "yellowgram",
    "url": "https://www.yellowgram.dev"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "bench": "tsx scripts/bench.ts",
    "demo": "npm run build && node scripts/demo.mjs",
    "demo:live": "node scripts/live-smoke-cache.mjs",
    "demo:sepolia": "node scripts/demo-sepolia.mjs",
    "eval": "tsx evaluation/run.ts",
    "eval:generate": "tsx evaluation/generate-fixtures.ts",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ethereum",
    "evm",
    "l2",
    "agent",
    "wallet",
    "policy",
    "allowlist",
    "permit2",
    "eip-7702",
    "idempotency",
    "simulation",
    "json-rpc",
    "viem"
  ],
  "license": "MIT",
  "dependencies": {
    "viem": "^2.57.1"
  },
  "peerDependencies": {
    "pg": "^8.11.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    }
  },
  "types": "./dist/api.d.ts"
}
