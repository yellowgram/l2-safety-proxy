# L2 Send Guard — copy to .env (never commit .env)

# Listen
L2SG_HOST=127.0.0.1
L2SG_PORT=8545

# Fail-open on uncertain/stale/sim failure (default true — recommended)
L2SG_FAIL_OPEN=true

# Comma-separated chain keys (≥2 for multi-ecosystem demo)
# Options: arb-sepolia, op-sepolia, base-sepolia
L2SG_CHAINS=arb-sepolia,base-sepolia
L2SG_DEFAULT_CHAIN=arb-sepolia

# Optional: override public testnet RPCs (no API keys required for smoke demo)
# L2SG_RPC_ARB_SEPOLIA=https://sepolia-rollup.arbitrum.io/rpc
# L2SG_RPC_BASE_SEPOLIA=https://sepolia.base.org
# L2SG_RPC_OP_SEPOLIA=https://sepolia.optimism.io

# Tip: point these at your existing Alchemy/QuickNode/eRPC URLs in production.
# This middleware sits IN FRONT of them — it is not a replacement RPC cloud.
