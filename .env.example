# L2 Send Guard — copy to .env (never commit .env)
#
# Pick ONE install path before you fill this file.
#
# --- Path A: Human / ops (simulation first) ---
# Layer 2 OFF. GUARD_MODE=open forwards uncertain sims.
# Do not set L2SG_POLICY_ENABLED=true on this path.
#
# --- Path B: Agent MSP (policy is the spend fence) ---
# Layer 2 ON. Copy policy.agent.example.json, replace 0x1111…/0x2222…
# placeholders, then: npm run policy:check -- ./policy.json
# Policy ON is not a safe agent. Read docs/RESIDUAL_BYPASSES.md.
# GUARD_MODE=open can still forward uncertain sims; strict aborts them (-32082).

# Listen. 127.0.0.1 is the default. 0.0.0.0 without an ACL is an
# unauthenticated forwarder onto your upstream RPC.
L2SG_HOST=127.0.0.1
L2SG_PORT=8545

# open = fail-open on uncertain (default). strict = abort (-32082).
GUARD_MODE=open
# Alias: L2SG_GUARD_MODE=open|strict
# Legacy, only when GUARD_MODE is unset (kept through 0.6.0): L2SG_FAIL_OPEN=true

# Comma-separated chain keys. Options: arb-sepolia, op-sepolia, base-sepolia
# Testnet only. No mainnet in this release.
L2SG_CHAINS=arb-sepolia,op-sepolia,base-sepolia
L2SG_DEFAULT_CHAIN=arb-sepolia

# Optional: override public testnet RPCs (no API keys required for smoke)
# L2SG_RPC_ARB_SEPOLIA=https://sepolia-rollup.arbitrum.io/rpc
# L2SG_RPC_BASE_SEPOLIA=https://sepolia.base.org
# L2SG_RPC_OP_SEPOLIA=https://sepolia.optimism.io

# This middleware sits IN FRONT of your RPC. It is not a replacement RPC cloud.

# Optional sim-only fallback when primary eth_call is uncertain.
# L2SG_RPC_FALLBACK_ARB_SEPOLIA=
# L2SG_RPC_FALLBACK_BASE_SEPOLIA=
# L2SG_RPC_FALLBACK_OP_SEPOLIA=

# Optional JSONL decision log (grep policy_denied). See docs/DECISION_LOG.md.
# L2SG_DECISION_LOG=./decisions.jsonl

# Live smoke burner (NEVER commit real values — local .env only)
# L2SG_BURNER_KEY=0x...
# L2SG_BURNER_ADDRESS=0x...

# --- Path B only. Leave commented on Path A. ---
# Start refuses if this is true and the file is missing, invalid, or still
# contains placeholder destinations.
# L2SG_POLICY_ENABLED=true
# L2SG_POLICY_FILE=./policy.json
# L2SG_POLICY_ALLOW_CREATE=false
# L2SG_POLICY_ALLOW_ANY=false
# true while policy is enabled refuses start (no destination fence).
# policy:check does not read these env vars.
# L2SG_POLICY_NOTIFY_URL=
# L2SG_POLICY_ERC20_RECIPIENT_CHECK=true
# Env allowlist is an alternative to a file (real addresses, not 0x1111…):
# L2SG_POLICY_ALLOWLIST=
# L2SG_POLICY_GLOBAL_MAX_WEI=
