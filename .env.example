# l2-send-guard — copy to .env and edit. Never commit .env.

# Where the proxy listens. Keep 127.0.0.1 unless you put an ACL in front:
# on 0.0.0.0 it forwards raw transactions for anyone who can reach it.
L2SG_HOST=127.0.0.1
L2SG_PORT=8545

# Chains to serve. Testnets have public default RPCs. Mainnets (ethereum,
# arbitrum, optimism, base, sepolia) need L2SG_RPC_<KEY>, e.g. L2SG_RPC_BASE.
L2SG_CHAINS=arb-sepolia,op-sepolia,base-sepolia
L2SG_DEFAULT_CHAIN=arb-sepolia
# L2SG_RPC_ARB_SEPOLIA=https://your-provider.example/arb-sepolia
# L2SG_RPC_FALLBACK_ARB_SEPOLIA=   # used only for simulation when the primary is unsure

# Policy (required). Start from policy.example.json, then: npx l2-send-guard check-policy ./policy.json
L2SG_POLICY_FILE=./policy.json
# Or run simulation only, with no spend rules:
# L2SG_POLICY=off

# strict (default): a send is refused when simulation can't decide (-32082).
# open: such sends are forwarded. Policy denials are never forwarded in either mode.
GUARD_MODE=strict

# State for rolling caps, idempotency keys and the bypass lock.
#   file:./l2-send-guard-state.jsonl (default) — one process on one machine
#   postgres://user@host/db                     — several processes or machines
#   memory                                      — tests only; forgets on restart
# L2SG_STORE=file:./l2-send-guard-state.jsonl

# How long an Idempotency-Key is remembered.
# L2SG_IDEMPOTENCY_TTL_SECONDS=86400

# What to do when a guarded sender's nonce moves without the guard:
#   lock (default) refuse that sender's sends until `l2-send-guard unlock <address>`
#   alert          keep sending, POST to L2SG_ALERT_WEBHOOK
#   off            ignore
# L2SG_BYPASS=lock
# L2SG_ALERT_WEBHOOK=https://hooks.example/l2-send-guard

# One JSON line per decision.
# L2SG_DECISION_LOG=./decisions.jsonl
